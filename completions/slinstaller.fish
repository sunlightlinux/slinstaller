# fish completion for slinstaller (slinstaller --completion fish)
complete -c slinstaller -l allow-insecure-http -d 'allow plain http:// for the repository, a config, image or report URL, and https-to-http redirects'
complete -c slinstaller -l apply -d 'carry out the plan'
complete -c slinstaller -l arch -r -d 'XBPS_TARGET_ARCH for the base system'
complete -c slinstaller -s b -r -d 'short for --block-device'
complete -c slinstaller -l block-device -r -d 'name:file, a storage alias for the config\'s targetMedia'
complete -c slinstaller -s c -r -d 'short for --config'
complete -c slinstaller -l completion -x -a 'bash fish' -d 'print a shell completion script for bash or fish, and exit'
complete -c slinstaller -l config -r -d 'the config file'
complete -c slinstaller -l copy-network -d 'copy the live system\'s network configuration into the installed system'
complete -c slinstaller -l crypt-file -r -d 'read the LUKS passphrase from this file'
complete -c slinstaller -l diagnostics -r -d 'where a failed install saves its diagnostics archive'
complete -c slinstaller -l discover -r -d 'print a config describing the layout already on this disk'
complete -c slinstaller -l extra-repo -r -d 'comma-separated remote xbps repositories searched ahead of --repo'
complete -c slinstaller -l force-destructive -d 'wipe a target disk even when a RAID array or LVM volume group on it also uses another disk, which that breaks'
complete -c slinstaller -l genpass -r -d 'print the crypt hash of this password for a config\'s users, and exit'
complete -c slinstaller -l image -r -d 'install the base system by unpacking this root filesystem image'
complete -c slinstaller -l in-target -r -d 'run this shell command inside the mounted target at --root, and exit'
complete -c slinstaller -s j -r -d 'short for --json-yaml'
complete -c slinstaller -l json-yaml -r -d 'convert this old JSON install descriptor'
complete -c slinstaller -l keys -r -d 'directory of xbps signing keys to seed into the target'
complete -c slinstaller -s l -r -d 'short for --log-level'
complete -c slinstaller -l list-disks -d 'list the machine\'s disks and exit'
complete -c slinstaller -l local-repo -r -d 'comma-separated xbps repositories on the live medium, searched before --repo'
complete -c slinstaller -l log -r -d 'also write the install\'s output to this file'
complete -c slinstaller -l log-level -r -d 'how much of the install is shown on the terminal'
complete -c slinstaller -l message-url -r -d 'look for installer messages'
complete -c slinstaller -l offline -d 'install only from --local-repo, without a remote mirror'
complete -c slinstaller -l packages -r -d 'comma-separated base packages to install'
complete -c slinstaller -l reboot -d 'reboot into the installed system when the install finishes'
complete -c slinstaller -l repo -r -d 'xbps repository for the base system'
complete -c slinstaller -l report-url -r -d 'POST the install\'s progress to this URL as JSON, stage by stage'
complete -c slinstaller -l resume -d 'with --apply, continue an install that failed while installing the base system'
complete -c slinstaller -l resume-from -x -a 'base-install fstab swapfile bootloader first-boot network save-config post-install' -d 'as --resume, but from the named stage'
complete -c slinstaller -l root -r -d 'with --apply, the target mount tree'
complete -c slinstaller -l skip-validation-all -d 'skip all config validation'
complete -c slinstaller -l skip-validation-size -d 'skip the minimum-size and disk-fit checks'
complete -c slinstaller -l swap-file-size -r -d 'create a swap file of this size, e.g. 2G'
complete -c slinstaller -l system-check -d 'check that this machine can install the config - tools, disks, repository - and exit without touching anything'
complete -c slinstaller -l template -r -d 'write a template config to this .yaml file, and exit'
complete -c slinstaller -l text -d 'use the plain text prompt installer instead of the full-screen TUI'
complete -c slinstaller -l through -x -a 'pre-install partition mount meta-fs base-install fstab swapfile bootloader first-boot network save-config post-install' -d 'with --apply, run only up to this install stage'
complete -c slinstaller -l unmount -d 'unmount everything under --root - what a staged install'
complete -c slinstaller -l version -d 'print version and exit'
